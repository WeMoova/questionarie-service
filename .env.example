# Server Configuration
PORT=8080
ENV=development

# FusionAuth Configuration
FUSIONAUTH_URL=https://auth.example.com
FUSIONAUTH_CLIENT_ID=your-fusionauth-application-id

# MongoDB Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
MONGODB_DATABASE=your_database_name
MONGODB_TIMEOUT=10s

# PostgreSQL Configuration (legacy - can be removed)
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SCHEMA=your_db_schema

# CORS Configuration
CORS_ORIGINS=https://services.wemoova.com,https://qa.services.wemoova.com,http://localhost:3000
